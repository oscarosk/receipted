# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID shown after you add the webhook URL in the sandbox app settings
PAYPAL_WEBHOOK_ID=

# Public URL PayPal redirects back to (your tunnel URL locally, your Render URL in production).
# It must match the Log in with PayPal return URL in the sandbox app: <APP_URL>/api/auth/paypal/callback
APP_URL=http://localhost:3000

# Optional overrides (defaults are the sandbox)
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_WEB_BASE=https://www.sandbox.paypal.com
# Must match the attributes ticked under Log in with PayPal. If PayPal says "invalid scope", try:
# PAYPAL_LOGIN_SCOPES=openid email
# PAYPAL_LOGIN_SCOPES=openid https://uri.paypal.com/services/paypalattributes
